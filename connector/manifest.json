{
  "schema": "aoa_social_connector_manifest_v1",
  "connector_id": "aoa-pinterest-connector",
  "provider": "pinterest",
  "display_name": "Pinterest",
  "version": "0.2.0-dev",
  "phase": "experimental",
  "source_family": "social-network",
  "runtime_owner": "abyss-stack",
  "policy_snapshot_date": "2026-09-04",
  "official_docs": "https://developers.pinterest.com/docs/api/v5/",
  "planes": {
    "evidence": {
      "status": "implemented_unadmitted",
      "effect": "read_only"
    },
    "draft": {
      "status": "planned",
      "effect": "none"
    },
    "publication_plan": {
      "status": "planned",
      "effect": "none"
    },
    "publication_commit": {
      "status": "disabled",
